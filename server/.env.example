# AI-Helper 诊断与监控服务端配置示例 (.env)
# 部署至生产服务器时，请复制此文件为 server/.env 并填入真实凭据

PORT=3001

# ⚠️ 必须修改：内部开发者大盘访问鉴权 Token (至少 32 位随机字符串)
# 生成方法: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=<CHANGE_ME_TO_A_STRONG_RANDOM_TOKEN>

# MySQL 数据库连接配置
# - 若使用 Docker Compose 运行，DB_HOST 保持为 mysql
# - 若直接在宿主机 PM2 运行，DB_HOST 改为 127.0.0.1
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=<CHANGE_ME_TO_A_STRONG_PASSWORD>
MYSQL_ROOT_PASSWORD=<CHANGE_ME_TO_A_STRONG_PASSWORD>
DB_NAME=ai_helper_telemetry
DB_CONNECTION_LIMIT=10

# 数据保留策略 (自动清除超过此天数的旧心跳事件，默认 90 天)
DATA_RETENTION_DAYS=90

# 若日后绑定了域名，在此填入新域名的完整上报接口地址
# 现有客户端上报时将自动从返回体中获取新地址，并静默平滑迁移至新域名！
# SERVER_PUBLIC_URL=https://monitor.yourdomain.com/api/telemetry/report

# 跨域设置 (生产环境请填入实际域名，如 https://yourdomain.com)
CORS_ORIGIN=https://yourdomain.com
