# AI-Helper 诊断与监控服务端配置示例 (.env)
# 部署至生产服务器时，请复制此文件为 server/.env 并填入真实 MySQL 连接凭据

PORT=3001

# MySQL 数据库连接配置
# - 若使用 Docker Compose 运行，DB_HOST 保持为 mysql
# - 若直接在宿主机 PM2 运行，DB_HOST 改为 127.0.0.1
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
MYSQL_ROOT_PASSWORD=your_mysql_password
DB_NAME=ai_helper_telemetry
DB_CONNECTION_LIMIT=10

# 跨域设置 (* 表示允许所有来源)
CORS_ORIGIN=*
