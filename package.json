{
  "name": "ai-helper",
  "version": "1.0.29",
  "description": "AI Helper - AI Agent 配置管理工具",
  "type": "module",
  "scripts": {
    "dev": "pnpm tauri dev",
    "build": "pnpm tauri build",
    "tauri": "tauri",
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css,json}\" && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:rs": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "lint:rs": "cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "bump": "powershell -ExecutionPolicy Bypass -File scripts/bump-version.ps1",
    "release": "powershell -ExecutionPolicy Bypass -File scripts/release.ps1"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.12.3",
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.3.0",
    "vite": "^7.3.0"
  },
  "dependencies": {
    "@radix-ui/react-popover": "^1.1.23",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-log": "2.8.0",
    "@tauri-apps/plugin-process": "^2.0.0",
    "@tauri-apps/plugin-updater": "^2.0.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.542.0",
    "motion": "^13.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1"
  }
}
