{
  "name": "ai-helper",
  "version": "1.0.25",
  "description": "AI Helper - AI Agent 配置管理工具",
  "type": "module",
  "scripts": {
    "dev": "pnpm tauri dev",
    "build": "pnpm tauri build",
    "tauri": "tauri",
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css,json}\" && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:rs": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "lint:rs": "cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "bump": "powershell -ExecutionPolicy Bypass -File scripts/bump-version.ps1",
    "release": "powershell -ExecutionPolicy Bypass -File scripts/release.ps1"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.12.3",
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@radix-ui/react-popover": "^1.1.23",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-log": "2.9.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.12.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  }
}
